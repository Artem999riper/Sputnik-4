@echo off
rem ────────────────────────────────────────────────────────────────────────
rem  Запуск сервера ПурГеоКом с АВТОПЕРЕЗАПУСКОМ.
rem  Если node упал (сбой сети, ошибка) — ждём и запускаем заново автоматически,
rem  вручную перезапускать не нужно. Для выхода закройте это окно или Ctrl+C.
rem ────────────────────────────────────────────────────────────────────────
title PurGeoCom Server (auto-restart)
pushd "%~dp0"
rem Признак для сервера: можно перезапускаться из админки (окно запустит node снова)
set PGK_LOOP=1

:loop
echo.
echo  [%date% %time%]  Запуск сервера...
node server.js
echo.
echo  [%date% %time%]  Сервер остановился (код %errorlevel%). Перезапуск через 3 сек...
echo  (Чтобы выйти — закройте окно или нажмите Ctrl+C)
timeout /t 3 /nobreak >nul
goto loop
